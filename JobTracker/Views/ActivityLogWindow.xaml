<Window x:Class="JobTracker.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log" Width="640" Height="420" MinWidth="480" MinHeight="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel>
                <TextBlock x:Name="EntryCountText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="📋 Copy" Padding="8,4" Margin="0,0,6,0" Click="Copy_Click"/>
                    <Button Content="🗑 Clear" Padding="8,4" Foreground="{StaticResource DangerBrush}" Click="Clear_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogItems" Margin="8"/>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="No Activity Yet" FontWeight="SemiBold" Margin="0,6,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="Import an archive or run a sync to see live progress here." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
