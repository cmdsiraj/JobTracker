<Window x:Class="JobTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <TabControl Margin="0">
        <TabItem Header="⚙ General">
            <StackPanel Margin="20">
                <TextBlock Text="Tray Watcher" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="TrayWatcherCheck" Content="Watch for new email in the background" Checked="TrayWatcher_Changed" Unchecked="TrayWatcher_Changed"/>
                <TextBlock Text="Off by default — JobTracker normally syncs on launch to save resources." Style="{StaticResource CaptionText}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <StackPanel x:Name="PollIntervalPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Check every" VerticalAlignment="Center"/>
                    <TextBox x:Name="PollIntervalBox" Width="50" Margin="6,0" TextAlignment="Center" LostFocus="PollInterval_LostFocus"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="👤 Account">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Gmail" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="GmailStatusText" Margin="0,0,0,4"/>
                    <TextBlock x:Name="GmailAccountText" Margin="0,0,0,8" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="OAuth Client ID" Style="{StaticResource CaptionText}"/>
                    <TextBox x:Name="ClientIdBox" FontFamily="Consolas" TextChanged="ClientIdBox_TextChanged"/>
                    <TextBlock Text="Your own Google Cloud OAuth client (Desktop app type, Gmail API enabled). Changing it signs you out."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="ReconnectButton" Content="Reconnect" Padding="10,5" Click="Reconnect_Click"/>
                        <Button x:Name="SignOutButton" Content="Sign Out" Padding="10,5" Margin="8,0,0,0" Foreground="{StaticResource DangerBrush}" Click="SignOut_Click"/>
                    </StackPanel>

                    <TextBlock Text="AI Provider" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="ProviderCombo" Margin="0,0,0,8" SelectionChanged="ProviderCombo_SelectionChanged"/>
                    <TextBlock Text="Model" Style="{StaticResource CaptionText}"/>
                    <TextBox x:Name="ModelBox" Margin="0,0,0,8" LostFocus="ModelBox_LostFocus"/>
                    <StackPanel x:Name="CustomEndpointPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Text="Endpoint URL (…/v1/chat/completions)" Style="{StaticResource CaptionText}"/>
                        <TextBox x:Name="EndpointBox" LostFocus="EndpointBox_LostFocus"/>
                    </StackPanel>
                    <TextBlock x:Name="ApiKeyStatusText" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <PasswordBox x:Name="ApiKeyBox" Width="220" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                        <Button x:Name="ValidateKeyButton" Content="Validate &amp; Save" Padding="10,5" Margin="8,0,0,0" Click="ValidateKey_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="KeyValidationText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="💾 Data">
            <StackPanel Margin="20">
                <TextBlock Text="Import" Style="{StaticResource SectionHeader}"/>
                <Button x:Name="ImportButton" Content="⬇️ Import Mail Archive…" HorizontalAlignment="Left" Padding="10,6" Click="Import_Click"/>
                <TextBlock Text="Bring in a Google Takeout .mbox archive. Already-imported emails are skipped automatically."
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock Text="Clear Data" Style="{StaticResource SectionHeader}"/>
                <Button Content="Clear All Applications &amp; Events…" HorizontalAlignment="Left" Padding="10,6"
                        Foreground="{StaticResource DangerBrush}" Click="ClearData_Click"/>
                <TextBlock x:Name="ClearedMessageText" Style="{StaticResource CaptionText}" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
                <TextBlock Text="Empties the tracker (applications, timelines, leads, sync history) so you can re-ingest from scratch. Keeps your Gmail connection, API keys, and settings."
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                <TextBlock Text="Danger Zone" Style="{StaticResource SectionHeader}"/>
                <Button Content="Erase All Data &amp; Restart Onboarding…" HorizontalAlignment="Left" Padding="10,6"
                        Foreground="{StaticResource DangerBrush}" Click="EraseAll_Click"/>
                <TextBlock Text="Deletes every application, event, secret, and preference on this PC. This cannot be undone."
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
