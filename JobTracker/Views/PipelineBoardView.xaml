<UserControl x:Class="JobTracker.Views.PipelineBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JobTracker.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TimelineScrubber x:Name="Scrubber" Grid.Row="0" Margin="12,12,12,0"/>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal" Margin="16"/>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="💼" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="No Applications Here" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="New job-related emails show up automatically after a sync." Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
