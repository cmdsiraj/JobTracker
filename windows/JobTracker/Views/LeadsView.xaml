<UserControl x:Class="JobTracker.Views.LeadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button Content="➕ Add Lead" DockPanel.Dock="Right" Padding="10,6" Click="AddLead_Click"/>
                <StackPanel x:Name="StageFilterPanel" Orientation="Horizontal"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LeadsPanel" Margin="16"/>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="✨" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="No Leads Yet" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Save job postings you want to apply to and people you want to reach out to."
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Add Lead" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="20,8" Click="AddLead_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
