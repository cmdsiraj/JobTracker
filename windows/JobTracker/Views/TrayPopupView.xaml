<UserControl x:Class="JobTracker.Views.TrayPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="300" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="JobTracker" FontWeight="Bold"/>
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>
            <Separator Margin="0,0,0,8"/>

            <StackPanel x:Name="RecentPanel"/>
            <TextBlock x:Name="NoAppsText" Text="No applications tracked yet." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>

            <Separator Margin="0,8,0,8"/>
            <Grid>
                <Button x:Name="SyncNowButton" Content="🔄 Sync Now" HorizontalAlignment="Left" Padding="8,4" Click="SyncNow_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Logs" Style="{StaticResource PlainButton}" Margin="0,0,10,0" Click="Logs_Click"/>
                    <Button Content="Open" Style="{StaticResource PlainButton}" Click="Open_Click"/>
                </StackPanel>
            </Grid>
            <Button Content="Quit JobTracker" Style="{StaticResource PlainButton}" HorizontalAlignment="Left"
                    Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" Click="Quit_Click"/>
        </StackPanel>
    </Border>
</UserControl>
