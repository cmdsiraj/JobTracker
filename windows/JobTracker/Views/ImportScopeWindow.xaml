<Window x:Class="JobTracker.Views.ImportScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Mail Archive" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Import Mail Archive" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <StackPanel x:Name="ScopeButtonsPanel"/>

        <Grid Margin="0,16,0,0">
            <Button Content="Cancel" HorizontalAlignment="Left" Padding="14,6" Click="Cancel_Click"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" MaxWidth="260" TextWrapping="Wrap"
                       Foreground="{StaticResource TertiaryTextBrush}"
                       Text="You can re-import a wider range later; already-imported emails are skipped."/>
        </Grid>
    </StackPanel>
</Window>
