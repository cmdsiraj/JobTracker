<Window x:Class="JobTracker.Views.MergeTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Into…" Width="420" Height="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Merge Into…" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged"/>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CandidatesPanel"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Text="There is nothing to merge into yet." Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <Button Grid.Row="3" Content="Cancel" HorizontalAlignment="Right" Padding="14,6" Margin="0,10,0,0" Click="Cancel_Click"/>
    </Grid>
</Window>
